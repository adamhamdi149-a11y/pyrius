# Copy to .env.local and fill in. Only public values belong here: anything EXPO_PUBLIC_ is built
# into the app and can be read by anyone who has it. Secret keys (OpenAI, SerpApi, Stripe,
# Supabase service role) stay on the server (the web app's environment), never in this file.

# The Pyrius server the app talks to (AI concierge, voice, flight search). For local development,
# run the web app with `npm run dev` and use your computer's LAN address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://pyrius.app

# Supabase project URL and anon (public) key: sign-in and sync. Row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
