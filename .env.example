# Copy to .env.local and fill in what you have. Every integration is optional:
# without a key that piece is either switched off or runs a clearly labelled demo.

# --- AI (server only, never exposed to the browser) ---
# Runs the AI concierge through server-checked tools; offers always come from the travel provider.
# OPENAI_REASONING (none, low, medium) tunes gpt-5 models; default low.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Flight data (server only) ---
# Live fares come from Google Flights through SerpApi (https://serpapi.com). With no key, flight
# search reports "not connected"; it never falls back to sample flights on its own.
SERPAPI_API_KEY=
# FLIGHT_PROVIDER=serpapi   (default when SERPAPI_API_KEY is set)
# FLIGHT_PROVIDER=demo      (generated example flights, for development and demos only)

# --- Supabase (auth + persistence). Without it, data stays in this browser only. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: lets the Stripe webhook write the `subscriptions` table.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (subscriptions). Without it, upgrades open a labeled demo checkout. ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_WEBHOOK_SECRET=
# Billing portal configuration (bpc_…), created by `node scripts/stripe-setup.mjs`.
STRIPE_PORTAL_CONFIG=
# Live key, only in .env.local, read by `node scripts/stripe-setup.mjs --mode live --vercel`.
# STRIPE_LIVE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
